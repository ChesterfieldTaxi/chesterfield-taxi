# ==============================================================================
# Chesterfield Taxi Web Portal - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Web Portal / Dispatch Console)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="chesterfield-taxi.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="chesterfield-taxi"
VITE_FIREBASE_STORAGE_BUCKET="chesterfield-taxi.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# ------------------------------------------------------------------------------
# Resend Transactional Email API (Server-side)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_YourResendApiKeyPlaceholder"
EMAIL_FROM="Chesterfield Taxi <dispatch@chesterfieldtaxi.com>"
ADMIN_ALERT_EMAIL="dispatch-alerts@chesterfieldtaxi.com"

# ------------------------------------------------------------------------------
# Google Maps Routing API (Server-side Only)
# ------------------------------------------------------------------------------
# Strictly kept on the server to prevent exposing secret keys or pricing tampering
GOOGLE_MAPS_SERVER_API_KEY="AIzaSyYourGoogleMapsServerApiKeyPlaceholder"
