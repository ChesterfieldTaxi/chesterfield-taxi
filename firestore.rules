rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && (
          (request.auth.token.email == 'admin@chesterfieldtaxi.com') ||
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role == 'customer')
        ))
      );
    }
    
    // Public Trips: Customers can submit new UNCONFIRMED web bookings
    match /trips/{tripId} {
      allow create: if request.resource.data.status in ['UNCONFIRMED', 'pending'] || request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    // Public Operational Configuration: Read-only for public quote calculations and tariffs
    match /zones/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /zoneGroups/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /locationCollections/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pricing_rules/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
