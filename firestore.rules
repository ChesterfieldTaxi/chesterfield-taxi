rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─────────────────────────────────────────────────────────────
    // Helper Functions & Role Definitions (CEL-safe: always check `'key' in map`!)
    // ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasAuthEmail() {
      return isAuthenticated() && 'email' in request.auth.token && request.auth.token.email != null;
    }

    function userDocExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserRole(roleName) {
      return userDocExists() && (
        ('role' in getUserData() && getUserData().role == roleName) ||
        ('roles' in getUserData() && getUserData().roles is list && roleName in getUserData().roles)
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (hasAuthEmail() && request.auth.token.email == 'admin@chesterfieldtaxi.com') ||
        hasUserRole('admin')
      );
    }

    function isDispatcher() {
      return isAdmin() || hasUserRole('dispatcher');
    }

    function isDriver() {
      return isDispatcher() || hasUserRole('driver');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTripCustomer(data) {
      return isAuthenticated() && (
        ('customerId' in data && data.customerId == request.auth.uid) ||
        ('userId' in data && data.userId == request.auth.uid) ||
        (hasAuthEmail() &&
         'passenger' in data &&
         data.passenger is map &&
         'email' in data.passenger &&
         data.passenger.email == request.auth.token.email)
      );
    }

    // ─────────────────────────────────────────────────────────────
    // 1. User Profiles & Accounts (/users/{userId})
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Passengers and drivers can view only their own profile; Dispatchers/Admins view all
      allow read: if isOwner(userId) || isDispatcher();

      // Self-registration strictly provisions a non-privileged 'customer' role
      allow create: if isDispatcher() || (
        isOwner(userId) &&
        request.resource.data.role == 'customer' &&
        (!('roles' in request.resource.data) || request.resource.data.roles == null || request.resource.data.roles == ['customer']) &&
        (!('isBlacklisted' in request.resource.data) || request.resource.data.isBlacklisted != true) &&
        (!('isArchived' in request.resource.data) || request.resource.data.isArchived != true) &&
        (!('status' in request.resource.data) || request.resource.data.status == null || request.resource.data.status == 'active')
      );

      // Users can update profile/savedPlaces/preferences, NEVER role/roles/governance fields
      // (Narrow legacy self-heal permitted only when roles was previously missing/null and mirrors existing role)
      allow update: if isDispatcher() || (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'roles', 'status', 'isBlacklisted', 'blacklistReason', 'isArchived', 'adminNotes'
          ]) ||
          (
            (!('roles' in resource.data) || resource.data.roles == null) &&
            'role' in resource.data &&
            resource.data.role != null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles']) &&
            request.resource.data.roles == [resource.data.role]
          )
        )
      );

      allow delete: if isDispatcher();
    }

    // ─────────────────────────────────────────────────────────────
    // 2. Trips & Bookings (/trips/{tripId})
    // ─────────────────────────────────────────────────────────────
    match /trips/{tripId} {
      // Public / Guest / Customer booking creation (never pre-assigned to a driver)
      allow create: if isDispatcher() || (
        request.resource.data.status in ['UNCONFIRMED', 'pending', 'CONFIRMED'] &&
        request.resource.data.pickupLocation != null &&
        request.resource.data.dropoffLocation != null &&
        request.resource.data.pricing != null &&
        request.resource.data.pricing.totalFare is number &&
        request.resource.data.pricing.totalFare >= 0 &&
        (!('assignedDriverId' in request.resource.data) || request.resource.data.assignedDriverId == null) &&
        (!('offeredToIds' in request.resource.data) || request.resource.data.offeredToIds == null || request.resource.data.offeredToIds.size() == 0) &&
        (
          !('customerId' in request.resource.data) ||
          request.resource.data.customerId == null ||
          (isAuthenticated() && request.resource.data.customerId == request.auth.uid)
        ) &&
        (
          !('userId' in request.resource.data) ||
          request.resource.data.userId == null ||
          (isAuthenticated() && request.resource.data.userId == request.auth.uid)
        )
      );

      // Single trip read: strictly authenticated owner, assigned/offered/convoy driver, or staff
      // Unauthenticated guests use zero-PII /tripTracking/{trackingToken} via /api/track
      allow get: if isDispatcher() ||
        isTripCustomer(resource.data) ||
        (isDriver() && (
          ('assignedDriverId' in resource.data && resource.data.assignedDriverId == request.auth.uid) ||
          ('offeredToIds' in resource.data && resource.data.offeredToIds is list && request.auth.uid in resource.data.offeredToIds) ||
          ('multiCarDriverIds' in resource.data && resource.data.multiCarDriverIds is list && request.auth.uid in resource.data.multiCarDriverIds)
        ));

      // List query: statically provable scoped queries for passengers, drivers, and staff
      allow list: if isDispatcher() ||
        (isAuthenticated() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          (hasAuthEmail() && resource.data.passenger.email == request.auth.token.email) ||
          resource.data.assignedDriverId == request.auth.uid ||
          request.auth.uid in resource.data.offeredToIds
        ));

      // Updates:
      // 1. Dispatchers / Admins: full operational control
      // 2. Assigned Driver: lifecycle, telemetry, meter extras, payment/completion fields only
      // 3. Associate Driver in a linked multi-car convoy: sync ONLY associate roster status onto sibling cars
      // 4. Offered Driver: strictly atomic accept (claiming unassigned offer) OR decline (into rejectedByIds)
      // 5. Customer Owner: claim guest trip, cancel pre-dispatch, update notes, or edit pre-dispatch
      allow update: if isDispatcher() ||
        // Assigned driver operational updates
        (isDriver() &&
          'assignedDriverId' in resource.data &&
          resource.data.assignedDriverId == request.auth.uid &&
          request.resource.data.assignedDriverId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'statusHistory', 'auditLog', 'driverTelemetry', 'currentLocation',
            'actualPickupTime', 'completedAt', 'cancelledAt', 'cancellationReason', 'cancelledBy',
            'pricing', 'payment', 'assignedVehicle', 'meterExtras', 'driverNotes', 'metadata',
            'multiCarAssociates', 'multiCarDriverIds', 'updatedAt'
          ])
        ) ||
        // Associate driver in a linked multi-car convoy: sync ONLY associate roster status onto sibling cars
        (isDriver() &&
          'multiCarGroupId' in resource.data &&
          resource.data.multiCarGroupId != null &&
          'multiCarDriverIds' in resource.data &&
          resource.data.multiCarDriverIds is list &&
          request.auth.uid in resource.data.multiCarDriverIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'multiCarAssociates', 'updatedAt'
          ])
        ) ||
        // Offered driver atomic accept OR decline (prevents hijacking an already-assigned trip)
        (isDriver() &&
          resource.data.status == 'offered' &&
          (!('assignedDriverId' in resource.data) || resource.data.assignedDriverId == null) &&
          'offeredToIds' in resource.data &&
          resource.data.offeredToIds is list &&
          request.auth.uid in resource.data.offeredToIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'assignedDriverId', 'assignedVehicle', 'offeredToIds', 'rejectedByIds',
            'statusHistory', 'auditLog', 'metadata', 'updatedAt'
          ]) && (
            // Accept offer
            (request.resource.data.status == 'assigned' &&
             request.resource.data.assignedDriverId == request.auth.uid &&
             request.resource.data.offeredToIds.size() == 0) ||
            // Decline offer
            (request.resource.data.assignedDriverId == null &&
             !(request.auth.uid in request.resource.data.offeredToIds) &&
             'rejectedByIds' in request.resource.data &&
             request.resource.data.rejectedByIds is list &&
             request.auth.uid in request.resource.data.rejectedByIds &&
             request.resource.data.status in ['offered', 'pending'])
          )
        ) ||
        // Customer: claim guest trip matching email
        (hasAuthEmail() &&
          (!('customerId' in resource.data) || resource.data.customerId == null) &&
          'passenger' in resource.data &&
          resource.data.passenger is map &&
          'email' in resource.data.passenger &&
          resource.data.passenger.email == request.auth.token.email &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerId', 'userId', 'updatedAt', 'auditLog'
          ])
        ) ||
        // Customer: cancel own pre-dispatch booking
        (isTripCustomer(resource.data) &&
          resource.data.status in ['UNCONFIRMED', 'pending', 'CONFIRMED', 'assigned', 'accepted'] &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'statusHistory', 'auditLog', 'cancellationReason', 'cancelledAt', 'cancelledBy', 'updatedAt'
          ])
        ) ||
        // Customer: update notes on non-terminal trip
        (isTripCustomer(resource.data) &&
          !(resource.data.status in ['completed', 'cancelled', 'DECLINED']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driverNotes', 'passengerNotes', 'specialInstructions', 'updatedAt', 'auditLog'
          ])
        ) ||
        // Customer: edit pre-dispatch booking details (never self-confirms or edits en_route/in_progress/completed)
        (isTripCustomer(resource.data) &&
          resource.data.status in ['UNCONFIRMED', 'pending', 'CONFIRMED'] &&
          request.resource.data.status in ['UNCONFIRMED', 'pending'] &&
          request.resource.data.pricing != null &&
          request.resource.data.pricing.totalFare is number &&
          request.resource.data.pricing.totalFare >= 0 &&
          (!('customerId' in resource.data) || request.resource.data.customerId == resource.data.customerId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'statusHistory', 'auditLog', 'pickupLocation', 'dropoffLocation',
            'intermediateStops', 'bookingType', 'scheduledPickupTime', 'vehicleTier',
            'passenger', 'pricing', 'driverNotes', 'metadata', 'updatedAt'
          ])
        );

      allow delete: if isDispatcher();
    }

    // ─────────────────────────────────────────────────────────────
    // 2B. Zero-PII Guest Live Tracking Projections (/tripTracking, /tripTrackingLookup)
    // ─────────────────────────────────────────────────────────────
    match /tripTracking/{trackingToken} {
      // Unguessable 128-bit token required; listing strictly forbidden
      allow get: if true;
      allow list: if false;

      // Strictly allowlisted zero-PII fields only (never passenger phone, email, gateCode, PO#)
      allow create: if request.resource.data.trackingToken == trackingToken &&
        request.resource.data.keys().hasOnly([
          'trackingToken', 'tripId', 'status', 'bookingType', 'scheduledPickupTime',
          'pickupDisplay', 'dropoffDisplay', 'pickupCoordinates', 'dropoffCoordinates',
          'intermediateStops', 'vehicleTier', 'vehicleDisplayName', 'assignedDriverFirstName',
          'assignedVehicle', 'driverTelemetry', 'etaMinutes', 'proxyPhone', 'updatedAt'
        ]);

      allow update: if (
        isDispatcher() ||
        isDriver() ||
        (isAuthenticated() &&
         'tripId' in resource.data &&
         resource.data.tripId != null &&
         exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
         isTripCustomer(get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data))
      ) &&
        request.resource.data.keys().hasOnly([
          'trackingToken', 'tripId', 'status', 'bookingType', 'scheduledPickupTime',
          'pickupDisplay', 'dropoffDisplay', 'pickupCoordinates', 'dropoffCoordinates',
          'intermediateStops', 'vehicleTier', 'vehicleDisplayName', 'assignedDriverFirstName',
          'assignedVehicle', 'driverTelemetry', 'etaMinutes', 'proxyPhone', 'updatedAt'
        ]);

      allow delete: if isDispatcher();
    }

    match /tripTrackingLookup/{lookupKey} {
      // Exact TripID + SHA-256(last4) lookup only; listing strictly forbidden
      allow get: if true;
      allow list: if false;

      allow create: if request.resource.data.keys().hasOnly(['trackingToken', 'updatedAt']) &&
        request.resource.data.trackingToken is string;

      allow update, delete: if isDispatcher();
    }

    // ─────────────────────────────────────────────────────────────
    // 3. Driver Shift Tracking & Vehicle Assignments (/vehicleAssignments)
    // ─────────────────────────────────────────────────────────────
    match /vehicleAssignments/{assignmentId} {
      allow read: if isDispatcher() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDispatcher() || (isDriver() && request.resource.data.driverId == request.auth.uid);
      allow update: if isDispatcher() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow delete: if isDispatcher();
    }

    // ─────────────────────────────────────────────────────────────
    // 4. Job Applications & Public Inquiries (/applications, /inquiries)
    // ─────────────────────────────────────────────────────────────
    match /applications/{applicationId} {
      allow create: if request.resource.data.firstName is string &&
                       request.resource.data.lastName is string &&
                       request.resource.data.phone is string;
      allow read, update, delete: if isDispatcher();
    }

    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.message is string;
      allow read, update, delete: if isDispatcher();
    }

    // ─────────────────────────────────────────────────────────────
    // 5. Driver Profiles & Roster (/drivers/{driverId})
    // ─────────────────────────────────────────────────────────────
    match /drivers/{driverId} {
      allow get: if isDispatcher() || (isDriver() && request.auth.uid == driverId);
      allow list: if isDispatcher();
      allow create, update: if isDispatcher() || (isDriver() && request.auth.uid == driverId);
      allow delete: if isDispatcher();
    }

    // ─────────────────────────────────────────────────────────────
    // 6. Public Operational Configurations vs. Staff-Only Settings & Billing
    // ─────────────────────────────────────────────────────────────
    match /zones/{document=**} {
      allow read: if true;
      allow write: if isDispatcher();
    }
    match /zoneGroups/{document=**} {
      allow read: if true;
      allow write: if isDispatcher();
    }
    match /locationCollections/{document=**} {
      allow read: if true;
      allow write: if isDispatcher();
    }
    match /pricingRules/{document=**} {
      allow read: if true;
      allow write: if isDispatcher();
    }
    match /tariffs/{document=**} {
      allow read: if true;
      allow write: if isDispatcher();
    }
    match /pricingConfig/{document=**} {
      allow read: if true;
      allow write: if isDispatcher();
    }

    // Split public vs staff config: NEVER expose corporateAccounts/invoices/auditTrail publicly
    match /config/publicSettings {
      allow read: if true;
      allow write: if isDispatcher();
    }
    match /config/{document=**} {
      allow read, write: if isDispatcher();
    }

    // Fleet assets visible to Dispatchers and Drivers (for shift vehicle picker)
    match /fleet/{document=**} {
      allow read: if isDispatcher() || isDriver();
      allow write: if isDispatcher();
    }

    // Sensitive B2B Corporate Accounts, Invoices, AR, Ledger & Driver Settlements
    match /corporateAccounts/{document=**} {
      allow read, write: if isDispatcher();
    }
    // Zero-PII hashed corporate verification lookup (never listable; contains only hashes & billing flags)
    match /corporateLookup/{lookupKey} {
      allow get: if true;
      allow list: if false;
      allow write: if isDispatcher();
    }
    match /invoices/{document=**} {
      allow read, write: if isDispatcher();
    }
    match /unbilledTransactions/{txId} {
      allow read, update, delete: if isDispatcher();
      allow create: if isDispatcher() || (isDriver() && request.resource.data.driverId == request.auth.uid);
    }
    match /financialLedger/{entryId} {
      allow read, update, delete: if isDispatcher();
      allow create: if isDispatcher() || (isDriver() && request.resource.data.driverId == request.auth.uid);
    }
    match /driverPayouts/{payoutId} {
      allow read: if isDispatcher() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDispatcher() || (isDriver() && request.resource.data.driverId == request.auth.uid);
      allow update, delete: if isDispatcher();
    }

    match /securityAudits/{document=**} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isDispatcher();
    }

    // ─────────────────────────────────────────────────────────────
    // 7. General Wildcard Security Lockdown
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isDispatcher();
    }
  }
}
